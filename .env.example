# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=3000
APP_NAME=YourApp
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=postgres
DB_PASS=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/myapp
MONGODB_POOL_MIN=2
MONGODB_POOL_MAX=10

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=express-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Admin ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your-admin-api-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-minimum-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REQUIRE_EMAIL_VERIFICATION=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp                    # 'smtp' | 'resend' | 'console'
EMAIL_FROM=your-verified-sender@email.com
EMAIL_FROM_NAME=YourApp

# SMTP — recommended: Brevo (brevo.com) free tier, 300 emails/day, no domain required
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-brevo-smtp-key

# Resend (used when EMAIL_PROVIDER=resend) — requires verified domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
